function showAuth(type){

document
.getElementById("loginForm")
.classList.toggle(
"hidden",
type !== "login"
);

document
.getElementById("signupForm")
.classList.toggle(
"hidden",
type !== "signup"
);

document
.getElementById("loginTab")
.classList.toggle(
"active",
type === "login"
);

document
.getElementById("signupTab")
.classList.toggle(
"active",
type === "signup"
);

document
.getElementById("authMessage")
.style.display="none";

}


/* ================================================= */
/* SIGN UP */
/* ================================================= */

async function signupUser(){

const username =
document
.getElementById("signupUsername")
.value
.trim()
.toLowerCase();

const email =
document
.getElementById("signupEmail")
.value
.trim()
.toLowerCase();

const password =
document
.getElementById("signupPassword")
.value;

const confirm =
document
.getElementById("signupConfirm")
.value;


if(!username){

showMessage("Username wajib diisi.");
return;

}

if(username.length < 3){

showMessage("Username minimal 3 karakter.");
return;

}

if(username === "aldi"){

showMessage("Username aldi sudah digunakan.");
return;

}

if(!email){

showMessage("Email wajib diisi.");
return;

}

if(password.length < 6){

showMessage("Password minimal 6 karakter.");
return;

}

if(password !== confirm){

showMessage("Konfirmasi password tidak sama.");
return;

}


try{

const usernameSnap =
await db
.ref("admins/" + username)
.once("value");

if(usernameSnap.exists()){

showMessage(
"Username sudah digunakan."
);

return;

}


const result =
await auth
.createUserWithEmailAndPassword(
email,
password
);

const user =
result.user;


/* SIMPAN DATA OPERATOR */

await db
.ref("admins/" + username)
.set({

username:username,
email:email,
role:"operator",
status:"pending",
uid:user.uid,
createdAt:Date.now()

});


await auth.signOut();


showMessage(
"✅ Pendaftaran berhasil.\n\n"+
"⏳ Akun Operator masih menunggu persetujuan Super Admin."
);


document
.getElementById("signupPassword")
.value="";

document
.getElementById("signupConfirm")
.value="";


}catch(error){

console.error(error);

showMessage(
getFirebaseError(error)
);

}

}


/* ================================================= */
/* LOGIN */
/* ================================================= */

async function loginUser(){

const username =
document
.getElementById("loginUsername")
.value
.trim()
.toLowerCase();

const password =
document
.getElementById("loginPassword")
.value;


if(!username || !password){

showMessage(
"Username dan password wajib diisi."
);

return;

}


try{

const snap =
await db
.ref("admins/" + username)
.once("value");

if(!snap.exists()){

showMessage(
"Username tidak ditemukan."
);

return;

}


const account =
snap.val();


const email =
account.email;


const result =
await auth
.signInWithEmailAndPassword(
email,
password
);

const user =
result.user;


currentUser = user;
currentAccount = account;
currentRole = account.role;


if(
account.role !== "superadmin" &&
account.status !== "approved"
){

await auth.signOut();

if(account.status === "pending"){

showMessage(
"⏳ Akun masih menunggu persetujuan Super Admin."
);

}else{

showMessage(
"❌ Akun belum mendapatkan akses."
);

}

return;

}


showPanel();

}catch(error){

console.error(error);

showMessage(
getFirebaseError(error)
);

}

}


/* ================================================= */
/* AUTH STATE */
/* ================================================= */

auth.onAuthStateChanged(
async function(user){

if(!user){

currentUser=null;
currentAccount=null;
currentRole=null;

document
.getElementById("panelPage")
.style.display="none";

document
.getElementById("authPage")
.style.display="flex";

return;

}


currentUser=user;


try{

const snap =
await db
.ref("admins")
.once("value");

const data =
snap.val() || {};

let account=null;


Object
.keys(data)
.forEach(key=>{

const item=data[key];

if(
item &&
item.email &&
item.email.toLowerCase()
===
user.email.toLowerCase()
){

account=item;

}

});


if(!account){

console.error(
"Data admins tidak ditemukan untuk:",
user.email
);

return;

}


if(
account.role !== "superadmin" &&
account.status !== "approved"
){

await auth.signOut();

return;

}


currentAccount=account;
currentRole=account.role;


showPanel();

}catch(error){

console.error(
"AUTH STATE DATABASE ERROR:",
error
);

}

});


/* ================================================= */
/* SHOW PANEL */
/* ================================================= */

function showPanel(){

if(!currentUser){

return;

}


document
.getElementById("authPage")
.style.display="none";

document
.getElementById("panelPage")
.style.display="block";


const header =
document.getElementById("headerUser");


if(currentAccount){

header.innerHTML=
`
${escapeHtml(currentAccount.username || "User")}
<br>
<span class="user-role">
${
currentRole === "superadmin"
? "SUPER ADMIN"
: "OPERATOR"
}
</span>
`;

}


if(currentRole === "superadmin"){

document
.getElementById("operatorTab")
.classList.remove("hidden");

document
.getElementById("historyTab")
.classList.remove("hidden");

document
.getElementById("operatorManagement")
.classList.remove("hidden");

}else{

document
.getElementById("operatorTab")
.classList.add("hidden");

document
.getElementById("historyTab")
.classList.add("hidden");

document
.getElementById("operatorManagement")
.classList.add("hidden");

}


listenPlayers();
listenGame();
listenRanking();


if(currentRole==="superadmin"){

listenOperators();
listenHistory();

}

}


