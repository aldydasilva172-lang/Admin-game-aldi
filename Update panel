class="reset"
onclick="tutupResetPemain()"
>

BATAL

</button>


</div>

</div>

</div>


<script>


// =================================================
// FIREBASE
// =================================================

const firebaseConfig = {

apiKey:
"AIzaSyD36RSQ5epRBSbeI9JnEkI2UevOg921xrI",

authDomain:
"game-aldi.firebaseapp.com",

databaseURL:
"https://game-aldi-default-rtdb.asia-southeast1.firebasedatabase.app",

projectId:
"game-aldi",

storageBucket:
"game-aldi.firebasestorage.app",

messagingSenderId:
"184345142676",

appId:
"1:184345142676:web:f19d19999c897d0ca95b81"

};


firebase.initializeApp(
firebaseConfig
);


const db =
firebase.database();


// =================================================
// ELEMENT
// =================================================

const rankingBox =
document.getElementById(
"ranking"
);


const popup =
document.getElementById(
"popup"
);


const editScore =
document.getElementById(
"editScore"
);


const editTitle =
document.getElementById(
"editTitle"
);


const fastName =
document.getElementById(
"fastName"
);


const fastTime =
document.getElementById(
"fastTime"
);


const pendingList =
document.getElementById(
"pendingList"
);


const activeList =
document.getElementById(
"activeList"
);


const spamList =
document.getElementById(
"spamList"
);


const winnerControl =
document.getElementById(
"winnerControl"
);


const resetPlayerPopup =
document.getElementById(
"resetPlayerPopup"
);


const resetPlayerPassword =
document.getElementById(
"resetPlayerPassword"
);


let currentKey = "";

let loading = false;


// =================================================
// PASSWORD
// =================================================

function cekPass(){

return document
.getElementById("pass")
.value === "00";

}


// =================================================
// SAFE KEY
// =================================================

function safeKey(text){

return btoa(
unescape(
encodeURIComponent(text)
)
)
.replace(/=/g,'');

}


// =================================================
// SAVE SCORE
// =================================================

async function saveScore(){

if(loading)
return;


if(!cekPass()){

alert("Password salah");

return;

}


const nama =
document
.getElementById("nama")
.value
.trim();


const score =
Number(
document
.getElementById("score")
.value
);


if(
!nama ||
isNaN(score)
){

alert("Isi data");

return;

}


loading = true;


try{

await db
.ref(
"ranking/" +
safeKey(nama)
)
.set({

name:nama,

score:score

});


document
.getElementById("nama")
.value="";


document
.getElementById("score")
.value="";


}catch(error){

alert("Gagal simpan");

}


loading = false;

}


// =================================================
// RESET GAME
// =================================================

async function resetGame(){

if(loading)
return;


if(!cekPass()){

alert("Password salah");

return;

}


if(
!confirm("Reset game?")
){

return;

}


loading = true;


try{

/*
  RESET GAME:
  1. Hapus hasil buzzer.
  2. Buka semua pemain yang SPAM.
  3. Pemain approved tetap approved.
*/

await db
.ref("game")
.remove();


const snap =
await db
.ref("players")
.once("value");


const data =
snap.val() || {};


const updates = {};


Object.keys(data)
.forEach(
id => {

if(
data[id] &&
data[id].spam === true
){

updates[
id + "/spam"
] = false;

}

});


if(
Object.keys(updates).length
){

await db
.ref("players")
.update(
updates
);

}


}catch(error){

console.log(error);

alert("Gagal reset");

}


loading = false;

}


// =================================================
// RESET PEMAIN POPUP
// =================================================

function bukaResetPemain(){

if(loading)
return;


if(!cekPass()){

alert("Password salah");

return;

}


resetPlayerPassword.value =
"";


resetPlayerPopup.style.display =
"flex";


setTimeout(
() => {

resetPlayerPassword.focus();

},
100
);

}


// =================================================
// PROSES RESET PEMAIN
// =================================================

async function prosesResetPemain(){

if(loading)
return;


const password =
resetPlayerPassword
.value;


if(password !== "00"){

alert("Password salah");

return;

}


if(
!confirm(
"RESET SEMUA PEMAIN?\n\nSemua nama pemain akan dihapus dan semua HP kembali ke MASUKKAN NAMA."
)
){

return;

}


loading = true;


try{

await db
.ref("players")
.remove();


await db
.ref("game")
.remove();


tutupResetPemain();


}catch(error){

console.log(error);

alert(
"Gagal reset pemain"
);

}


loading = false;

}


// =================================================
// TUTUP POPUP RESET PEMAIN
// =================================================

function tutupResetPemain(){

resetPlayerPopup.style.display =
"none";

resetPlayerPassword.value =
"";

}


// =================================================
// EDIT
// =================================================

function editPlayer(
key,
name,
score
){

currentKey =
key;


popup.style.display =
"flex";


editTitle.innerText =
"EDIT " + name;


editScore.value =
score;

}


// =================================================
// SAVE EDIT
// =================================================

async function saveEdit(){

if(loading)
return;


if(!cekPass()){

alert("Password salah");

return;

}


const score =
Number(
editScore.value
);


if(isNaN(score)){

alert("Isi poin");

return;

}


loading = true;


try{

await db
.ref(
"ranking/" +
currentKey
)
.update({

score:score

});


popup.style.display =
"none";


}catch(error){

alert("Gagal edit");

}


loading = false;

}


// =================================================
// DELETE
// =================================================

async function hapusPlayer(
key
){

if(loading)
return;


if(!cekPass()){

alert("Password salah");

return;

}


if(
!confirm("Hapus player?")
){

return;

}


loading = true;


try{

await db
.ref(
"ranking/" +
key
)
.remove();


}catch(error){

alert("Gagal hapus");

}


loading = false;

}


// =================================================
// CLOSE POPUP
// =================================================

function closePopup(){

popup.style.display =
"none";

}


// =================================================
// PLAYERS REALTIME
// =================================================

db.ref("players")
.on(
"value",
snap => {

const data =
snap.val() || {};


let pendingHTML = "";

let activeHTML = "";

let spamHTML = "";


let pendingCount = 0;

let activeCount = 0;

let spamCount = 0;


Object.keys(data)
.forEach(
id => {

const player =
data[id] || {};


const nama =
player.name ||
"Unknown";


/* =============================================
   PENDING
============================================= */

if(
player.status === "pending"
){

pendingCount++;


pendingHTML += `

<div class="pending-player">

<div class="pending-name">

${escapeHTML(nama)}

</div>


<div class="pending-info">

⏳ Meminta izin bermain

</div>


<button
class="approve"
onclick="approvePlayer('${id}')"
>

✅ SETUJUI

</button>

</div>

`;

}


/* =============================================
   ACTIVE
============================================= */

if(
player.status === "approved"
){

activeCount++;


activeHTML += `

<div class="active-player">

<div class="active-name">

${escapeHTML(nama)}

</div>


<div class="active-info">

🟢 Pemain sudah disetujui

${
player.spam === true
? "<br>🔴 Status: SPAM"
: ""
}

</div>


<div class="active-buttons">

<button
class="keluarkan-player"
onclick="keluarkanPlayer('${id}')"
>

❌ KELUARKAN

</button>

</div>

</div>

`;

}


/* =============================================
   SPAM
============================================= */

if(
player.spam === true
){

spamCount++;


spamHTML += `

<div class="spam-player">

<div class="spam-name">

⚠️ ${escapeHTML(nama)}

</div>


<div class="spam-info">

Pemain terkena double tap / spam.

<br>

Status: 🔴 SPAM

</div>


<button
class="open-spam"
onclick="bukaSpam('${id}')"
>

🔓 BUKA SPAM

</button>

</div>

`;

}

});


/* =============================================
   PENDING
============================================= */

if(
pendingCount === 0
){

pendingHTML = `

<div class="empty">

Tidak ada pemain menunggu.

</div>

`;

}


pendingList.innerHTML =
pendingHTML;


/* =============================================
   ACTIVE
============================================= */

if(
activeCount === 0
){

activeHTML = `

<div class="empty">

Belum ada pemain aktif.

</div>

`;

}


activeList.innerHTML =
activeHTML;


/* =============================================
   SPAM
============================================= */

if(
spamCount === 0
){

spamHTML = `

<div class="empty">

Belum ada pemain terkena spam.

</div>

`;

}


spamList.innerHTML =
spamHTML;

});


// =================================================
// APPROVE PLAYER
// =================================================

function approvePlayer(id){

if(!cekPass()){

alert("Password salah");

return;

}


db.ref(
"players/" +
id
)
.update({

status:
"approved",

spam:
false

});

}


// =================================================
// BUKA SPAM
// =================================================

async function bukaSpam(
playerID
){

if(loading)
return;


if(!cekPass()){

alert("Password salah");

return;

}


if(!playerID){

alert(
"ID player tidak ditemukan"
);

return;

}


if(
!confirm(
"Buka SPAM pemain ini?\n\nPemain akan kembali normal tanpa mereset game."
)
){

return;

}


loading = true;


try{

/*
  PENTING:

  HANYA mengubah status SPAM pemain.

  TIDAK:
  - menghapus game
  - mereset game
  - mengubah pemenang
  - mengubah pemain lain
*/

await db
.ref(
"players/" +
playerID
)
.update({

spam:
false,

status:
"approved"

});


}catch(error){

console.log(error);

alert(
"Gagal membuka spam"
);

}


loading = false;

}


// =================================================
// KELUARKAN PLAYER KAPAN SAJA
// =================================================

async function keluarkanPlayer(
playerID
){

if(loading)
return;


if(!cekPass()){

alert("Password salah");

return;

}


if(!playerID){

alert(
"ID player tidak ditemukan"
);

return;

}


if(
!confirm(
"Keluarkan pemain ini dari game?"
)
){

return;

}


loading = true;


try{

await db
.ref(
"players/" +
playerID
)
.update({

status:
"pending",

spam:
false

});


const gameSnap =
await db
.ref("game")
.once("value");


const gameData =
gameSnap.val();


/*
  Kalau pemain yang dikeluarkan adalah
  pemenang, game dihapus.

  Kalau pemain bukan pemenang,
  game tetap dipertahankan.
*/

if(
gameData &&
gameData.playerID === playerID
){

await db
.ref("game")
.remove();

}


}catch(error){

console.log(error);

alert(
"Gagal mengeluarkan pemain"
);

}


loading = false;

}


// =================================================
// GAME / PLAYER TERCEPAT
// =================================================

db.ref("game")
.on(
"value",
snap => {

const data =
snap.val();


if(
data &&
data.clicked === true
){

fastName.innerText =
data.player ||
"Unknown";


fastTime.innerText =
"BOLEH JAWAB";


winnerControl.innerHTML = `

<div class="fast-card">

<div class="fast-player-name">

${escapeHTML(
data.player ||
"Unknown"
)}

</div>


<div class="fast-player-info">

🔔 PEMAIN BERHAK MENJAWAB

</div>


<div class="btn-group">

<button
class="continue"
onclick="continueGame()"
>

▶ LANJUT

</button>


<button
class="remove"
onclick="removeWinner('${data.playerID}')"
>

❌ KELUARKAN

</button>

</div>

</div>

`;

}else{

fastName.innerText =
"Belum ada";


fastTime.innerText =
"Menunggu player tercepat";


winnerControl.innerHTML = `

<div class="notice">

🔥 Menunggu pemain menekan buzzer

</div>

`;

}

});


// =================================================
// LANJUT
// =================================================

async function continueGame(){

if(loading)
return;


if(!cekPass()){

alert("Password salah");

return;

}


if(
!confirm(
"Lanjutkan game?\n\nTampilan menang/kalah di HP pemain tetap ditampilkan."
)
){

return;

}


/*
  LANJUT TIDAK MENGHAPUS game.

  Jadi tampilan hasil pemain tetap.
*/

alert(
"Game dilanjutkan.\n\nTampilan hasil pemain tetap."
);

}


// =================================================
// KELUARKAN PEMENANG
// =================================================

async function removeWinner(
playerID
){

if(loading)
return;


if(!cekPass()){

alert("Password salah");

return;

}


if(!playerID){

alert(
"ID player tidak ditemukan"
);

return;

}


if(
!confirm(
"Keluarkan pemain ini dari game?"
)
){

return;

}


loading = true;


try{

/*
  Pemenang dikeluarkan menjadi pending.

  Karena pemain ini bisa saja sedang menjadi
  winner, game akan dihapus.

  Pemain lain akan kembali ke ronde baru.
*/

await db
.ref(
"players/" +
playerID
)
.update({

status:
"pending",

spam:
false

});


const gameSnap =
await db
.ref("game")
.once("value");


const gameData =
gameSnap.val();


if(
gameData &&
gameData.playerID === playerID
){

await db
.ref("game")
.remove();

}


}catch(error){

alert(
"Gagal mengeluarkan pemain"
);

}


loading = false;

}


// =================================================
// RANKING
// =================================================

db.ref("ranking")
.on(
"value",
snap => {

const data =
snap.val() || {};


let arr = [];


for(
let key in data
){

arr.push({

key:key,

name:
data[key].name ||
"Unknown",

score:
data[key].score ||
0

});

}


arr.sort(
(a,b) =>
b.score - a.score
);


rankingBox.innerHTML =
"";


if(!arr.length){

rankingBox.innerHTML =

"<div class='empty'>" +
"Belum ada player" +
"</div>";

return;

}


const max =
arr[0].score || 1;


arr.forEach(
(item,index) => {

const persen =
(item.score / max) *
100;


const div =
document.createElement(
"div"
);


div.className =
"player";


div.innerHTML = `

<h3>

${index+1}.
${escapeHTML(item.name)}
—
${item.score} poin

</h3>


<div class="bar">

<div
class="fill"
style="width:${persen}%"
></div>

</div>


<div class="btn-group">

<button
class="edit"
>

EDIT

</button>


<button
class="delete"
>

HAPUS

</button>

</div>

`;


div.querySelector(
".edit"
)
.onclick = () => {

editPlayer(
item.key,
item.name,
item.score
);

};


div.querySelector(
".delete"
)
.onclick = () => {

hapusPlayer(
item.key
);

};


rankingBox.appendChild(
div
);

});

});


// =================================================
// ESCAPE HTML
// =================================================

function escapeHTML(text){

const div =
document.createElement("div");


div.textContent =
text || "";


return div.innerHTML;

}

</script>

</body>

</html>
