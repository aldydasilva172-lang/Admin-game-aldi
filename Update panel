/* ================================================= */
/* RANKING */
/* ================================================= */

function safeKey(text){

return btoa(
unescape(
encodeURIComponent(text)
)
)
.replace(
/[+/=]/g,
""
);

}


function listenRanking(){

db.ref("ranking")
.on("value",snapshot=>{

rankingData=
snapshot.val() || {};

renderRanking();

});

}


function renderRanking(){

const box=
document.getElementById(
"rankingList"
);

box.innerHTML="";


const arr=
Object.keys(rankingData)
.map(key=>({

key:key,
...rankingData[key]

}))
.sort(
(a,b)=>
Number(b.score||0)
-
Number(a.score||0)
);


if(!arr.length){

box.innerHTML=
emptyHTML(
"Belum ada ranking."
);

return;

}


arr.forEach((item,index)=>{

box.innerHTML += `

<div class="ranking-item">

<div class="rank-left">

<div class="rank-number">
#${index+1}
</div>

<div class="item-name">
${escapeHtml(item.name || "-")}
</div>

</div>

<div class="rank-score">
${Number(item.score||0)}
</div>

</div>

`;

});

}


/* ================================================= */
/* SAVE SCORE */
/* ================================================= */

async function saveScore(){

const name=
document
.getElementById("scoreName")
.value
.trim();

const score=
Number(
document
.getElementById("scoreValue")
.value
);


if(!name){

alert(
"Masukkan nama pemain."
);

return;

}

if(!score){

alert(
"Masukkan jumlah poin."
);

return;

}


const key=
safeKey(name);


try{

const ref=
db.ref("ranking/"+key);

const snap=
await ref.once("value");

const old=
snap.val() || {};


await ref.set({

name:name,

score:
Number(old.score||0)+score

});


await logActivity(
"🏆 Menambahkan poin " +
score +
" untuk pemain: " +
name
);


document
.getElementById("scoreName")
.value="";

document
.getElementById("scoreValue")
.value="";


alert(
"✅ Poin berhasil disimpan."
);

}catch(error){

alert(
"❌ Gagal menyimpan poin.\n\n"+
error.code
);

}

}


