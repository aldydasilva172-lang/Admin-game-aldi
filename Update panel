/* ================================================= */
/* HISTORY */
/* ================================================= */

function listenHistory(){

if(currentRole!=="superadmin"){

return;

}


db.ref("activityLogs")
.orderByChild("timestamp")
.on("value",snapshot=>{

historyData =
snapshot.val() || {};

renderHistory();

});

}


function renderHistory(){

const box =
document.getElementById(
"historyList"
);

box.innerHTML="";


const arr =
Object.keys(historyData)
.map(key=>({

key:key,
...historyData[key]

}))
.sort(
(a,b)=>
Number(b.timestamp||0) -
Number(a.timestamp||0)
);


if(!arr.length){

box.innerHTML =
emptyHTML(
"Belum ada riwayat aktivitas."
);

return;

}


/* BATASI 200 RIWAYAT TERBARU */

arr
.slice(0,200)
.forEach(item=>{

const date =
item.timestamp
? new Date(
item.timestamp
)
: null;


const time =
date
? date.toLocaleString(
"id-ID",
{
day:"2-digit",
month:"2-digit",
year:"numeric",
hour:"2-digit",
minute:"2-digit",
second:"2-digit"
}
)
: "-";


const role =
item.role === "superadmin"
? "SUPER ADMIN"
: "OPERATOR";


box.innerHTML += `

<div class="history-item">

<div class="history-top">

<div class="history-user">
👤 ${escapeHtml(
item.username || "-"
)}
</div>

<div class="history-time">
${time}
</div>

</div>

<div class="history-action">
${escapeHtml(
item.action || "-"
)}
</div>

<div class="history-role">
${role}
</div>

</div>

`;

});

}


