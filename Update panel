function listenPlayers(){

db.ref("players")
.on("value",snapshot=>{

playersData =
snapshot.val() || {};

renderPlayers();

});

}


function renderPlayers(){

const pending =
document.getElementById("pendingList");

const active =
document.getElementById("activeList");

const spam =
document.getElementById("spamList");


pending.innerHTML="";
active.innerHTML="";
spam.innerHTML="";


let pendingCount=0;
let activeCount=0;
let spamCount=0;


Object.keys(playersData)
.forEach(id=>{

const p=
playersData[id] || {};

const name=
escapeHtml(p.name || id);


if(p.spam){

spamCount++;

spam.innerHTML +=
playerHTML(
id,
name,
"spam"
);

return;

}


if(p.status==="approved"){

activeCount++;

active.innerHTML +=
playerHTML(
id,
name,
"active"
);

}else{

pendingCount++;

pending.innerHTML +=
playerHTML(
id,
name,
"pending"
);

}

});


document
.getElementById("pendingCount")
.innerText=pendingCount;

document
.getElementById("activeCount")
.innerText=activeCount;

document
.getElementById("spamCount")
.innerText=spamCount;


if(!pendingCount){

pending.innerHTML=
emptyHTML(
"🎉 Tidak ada pemain menunggu."
);

}

if(!activeCount){

active.innerHTML=
emptyHTML(
"Belum ada pemain aktif."
);

}

if(!spamCount){

spam.innerHTML=
emptyHTML(
"✅ Tidak ada pemain spam."
);

}

}


