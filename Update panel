await operatorRef.update({

role:"operator",
status:"approved",
approvedAt:Date.now(),
approvedBy:SUPER_USERNAME

});


await logActivity(
"👑 Menyetujui Operator: " +
username
);


alert(
"✅ Operator "+
username+
" berhasil disetujui."
);

}catch(error){

console.error(
"APPROVE OPERATOR ERROR:",
error
);

