</div>

</div>


<!-- ================================================= -->
<!-- PEMAIN SPAM -->
<!-- ================================================= -->

<div class="card">

<h2>

🔴 PEMAIN SPAM

</h2>


<div
id="spamList"
>

<div class="empty">

Belum ada pemain terkena spam.

</div>

</div>

</div>


<!-- ================================================= -->
<!-- PLAYER TERCEPAT -->
<!-- ================================================= -->

<div class="card">

<h2>

PLAYER TERCEPAT

</h2>


<div id="fastBox">

<div style="font-size:50px;">

🥇

</div>


<div id="fastName">

Belum ada

