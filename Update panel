<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Poppins,sans-serif;
background:
radial-gradient(circle at top,#151b3d,#05060c 65%);
color:#fff;
min-height:100vh;
}

button,input{
font-family:Poppins,sans-serif;
}

button{
cursor:pointer;
}

.hidden{
display:none !important;
}


/* LOGIN */

#authPage{
min-height:100vh;
display:flex;
align-items:center;
justify-content:center;
padding:20px;
}

.auth-card{
width:100%;
max-width:430px;
padding:32px 24px;
border-radius:28px;
background:rgba(20,24,55,.55);
border:1px solid rgba(255,255,255,.12);
box-shadow:
0 25px 70px rgba(0,0,0,.5),
inset 0 1px rgba(255,255,255,.08);
backdrop-filter:blur(22px);
-webkit-backdrop-filter:blur(22px);
}

.auth-logo{
text-align:center;
font-family:Orbitron,sans-serif;
font-size:25px;
font-weight:800;
letter-spacing:2px;
margin-bottom:7px;
}

.auth-subtitle{
text-align:center;
font-size:12px;
opacity:.6;
margin-bottom:28px;
}

.auth-tabs{
display:flex;
gap:8px;
margin-bottom:22px;
}

.auth-tabs button{
flex:1;
padding:11px;
border:0;
border-radius:12px;
background:rgba(255,255,255,.06);
color:#aaa;
}

.auth-tabs button.active{
background:linear-gradient(135deg,#006cff,#00d9ff);
color:#fff;
font-weight:600;
}

.field{
margin-bottom:14px;
}

.field label{
display:block;
font-size:11px;
opacity:.7;
margin-bottom:6px;
}

.field input{
width:100%;
padding:13px 14px;
border-radius:13px;
border:1px solid rgba(255,255,255,.12);
background:rgba(0,0,0,.25);
color:#fff;
outline:none;
}

.field input:focus{
border-color:#00cfff;
box-shadow:0 0 0 2px rgba(0,207,255,.1);
}

.main-btn{
width:100%;
padding:14px;
border:0;
border-radius:14px;
background:linear-gradient(135deg,#006cff,#00d9ff);
color:#fff;
font-weight:700;
font-size:14px;
margin-top:5px;
}

.forgot{
display:block;
text-align:center;
margin-top:14px;
font-size:12px;
color:#00d9ff;
cursor:pointer;
}

.auth-message{
margin-top:15px;
padding:11px;
border-radius:12px;
background:rgba(255,255,255,.06);
font-size:12px;
text-align:center;
display:none;
white-space:pre-line;
}


/* HEADER */

#panelPage{
display:none;
}

.header{
position:sticky;
top:0;
z-index:100;
background:rgba(5,7,17,.75);
backdrop-filter:blur(18px);
-webkit-backdrop-filter:blur(18px);
border-bottom:1px solid rgba(255,255,255,.08);
}

.header-inner{
max-width:1100px;
margin:auto;
padding:15px 16px;
display:flex;
align-items:center;
justify-content:space-between;
gap:12px;
}

.logo{
font-family:Orbitron,sans-serif;
font-size:17px;
font-weight:800;
letter-spacing:1px;
}

.logo span{
color:#00d9ff;
}

.user-info{
text-align:right;
font-size:10px;
opacity:.75;
}

.user-role{
color:#00d9ff;
font-weight:600;
}

.logout-btn{
margin-left:8px;
padding:8px 11px;
border-radius:10px;
border:1px solid rgba(255,255,255,.1);
background:rgba(255,255,255,.05);
color:#fff;
font-size:11px;
}


/* CONTAINER */

.container{
max-width:1100px;
margin:auto;
padding:18px 14px 50px;
}


/* GAME */

.game-card{
padding:20px;
border-radius:22px;
background:
linear-gradient(
145deg,
rgba(0,100,255,.18),
rgba(0,255,255,.05)
);
border:1px solid rgba(0,210,255,.18);
box-shadow:0 18px 50px rgba(0,0,0,.3);
}

.game-title{
font-family:Orbitron,sans-serif;
font-size:13px;
opacity:.7;
margin-bottom:8px;
}

.game-status{
font-size:22px;
font-weight:700;
}

.game-winner{
margin-top:7px;
font-size:13px;
color:#00eaff;
}

.reset-game-btn{
width:100%;
margin-top:17px;
padding:15px;
border:0;
border-radius:14px;
background:linear-gradient(135deg,#ff1744,#ff6d00);
color:#fff;
font-weight:800;
font-size:14px;
}


/* STATS */

.stats{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:10px;
margin:14px 0;
}

.stat{
padding:15px;
border-radius:17px;
background:rgba(255,255,255,.045);
border:1px solid rgba(255,255,255,.07);
text-align:center;
}

.stat-number{
font-family:Orbitron,sans-serif;
font-size:22px;
font-weight:700;
}

.stat-label{
font-size:10px;
opacity:.55;
margin-top:4px;
}


/* TABS */

.tabs{
display:flex;
gap:7px;
overflow-x:auto;
padding:3px 1px 10px;
scrollbar-width:none;
}

.tabs::-webkit-scrollbar{
display:none;
}

.tab{
flex:0 0 auto;
padding:10px 14px;
border-radius:12px;
border:1px solid rgba(255,255,255,.08);
background:rgba(255,255,255,.045);
color:#aaa;
font-size:11px;
font-weight:600;
}

.tab.active{
background:linear-gradient(135deg,#006cff,#00cfff);
color:#fff;
border-color:transparent;
}


/* SECTION */

.section{
display:none;
}

.section.active{
display:block;
}

.section-title{
font-family:Orbitron,sans-serif;
font-size:15px;
margin:12px 0;
}


/* LIST */

.list{
display:flex;
flex-direction:column;
gap:10px;
}

.item{
padding:15px;
border-radius:17px;
background:rgba(255,255,255,.045);
border:1px solid rgba(255,255,255,.07);
}

.item-main{
display:flex;
justify-content:space-between;
gap:10px;
align-items:center;
}

.item-name{
font-weight:600;
font-size:14px;
}

.item-email{
font-size:10px;
opacity:.55;
margin-top:3px;
word-break:break-all;
}

.badge{
display:inline-block;
margin-top:7px;
padding:4px 8px;
border-radius:8px;
font-size:9px;
background:rgba(255,255,255,.08);
}

.actions{
display:flex;
flex-wrap:wrap;
gap:7px;
margin-top:12px;
}

.action{
border:0;
border-radius:10px;
padding:9px 11px;
font-size:10px;
font-weight:600;
color:#fff;
background:rgba(255,255,255,.09);
}

.action.blue{
background:#006cff;
}

.action.green{
background:#00a86b;
}

.action.red{
background:#e91e43;
}

.action.orange{
background:#f57c00;
}

.empty{
padding:30px 15px;
text-align:center;
opacity:.45;
font-size:12px;
}


/* POINTS */

.points-box{
padding:18px;
border-radius:18px;
background:rgba(255,255,255,.045);
border:1px solid rgba(255,255,255,.07);
