<style>

*{

margin:0;
padding:0;
box-sizing:border-box;

}


body{

font-family:Arial,sans-serif;

background:#08111f;

color:white;

padding:15px;

}


.header{

text-align:center;

font-size:24px;

font-weight:bold;

margin-bottom:20px;

}


.card{

background:#111827;

padding:18px;

border-radius:18px;

margin-bottom:18px;

}


h2{

font-size:18px;

margin-bottom:15px;

}


input{

width:100%;

height:50px;

border:none;

outline:none;

border-radius:12px;

padding:0 15px;

margin-top:10px;

background:#1f2937;

color:white;

font-size:16px;

}


button{

flex:1;

border:none;

height:48px;

border-radius:12px;

font-weight:bold;

color:white;

cursor:pointer;

}


button:disabled{

opacity:.5;

cursor:not-allowed;

}


.btn-group{

display:flex;

gap:10px;

margin-top:15px;

}


.save{

background:#00b894;

}


.reset{

background:#d63031;

}


.edit{

background:#fdcb6e;

color:black;

}


.delete{

background:#e84393;

}


/* ================= PLAYER ================= */

.player{

background:#1f2937;

padding:15px;

border-radius:15px;

margin-top:15px;

}


.bar{

width:100%;

height:12px;

background:#2d3748;

border-radius:20px;

overflow:hidden;

margin-top:10px;

}


.fill{

height:100%;

background:#00d2ff;

}


/* ================= FAST ================= */

#fastBox{

text-align:center;

}


#fastName{

font-size:30px;

font-weight:bold;

margin-top:10px;

color:gold;

}


#fastTime{

margin-top:8px;

color:#ccc;

}


/* ================= EMPTY ================= */

.empty{

text-align:center;

padding:20px;

color:#aaa;

}


/* ================= POPUP ================= */

#popup{

display:none;

position:fixed;

inset:0;

background:rgba(0,0,0,0.7);

justify-content:center;

align-items:center;

padding:20px;

z-index:99999;

}


.popup-content{

background:#111827;

padding:20px;

border-radius:20px;

width:100%;

max-width:320px;

}


/* ================= RESET PEMAIN POPUP ================= */

#resetPlayerPopup{

display:none;

position:fixed;

inset:0;

background:rgba(0,0,0,0.78);

justify-content:center;

align-items:center;

padding:20px;

z-index:100000;

}


.reset-player-content{

background:#111827;

padding:22px;

border-radius:20px;

width:100%;

max-width:340px;

border:1px solid rgba(255,255,255,.08);

}


.reset-warning{

text-align:center;

color:#ff7675;

font-size:13px;

line-height:1.6;

margin-top:8px;

}


.open-spam{

width:100%;

background:#00b894;

margin-top:12px;

}


.open-spam:active{

transform:scale(.98);

}


/* ================= NEW CONTROL ================= */

.section-title{

font-size:14px;

font-weight:bold;

color:#00d2ff;

margin-bottom:10px;

}


.pending-player{

background:#1f2937;

padding:15px;

border-radius:15px;

margin-top:12px;

}


.pending-name{

font-size:20px;

font-weight:bold;

margin-bottom:5px;

}


.pending-info{

font-size:12px;

color:#aaa;

margin-bottom:12px;

}


.approve{

width:100%;

background:#00b894;

}


/* ================= FAST ================= */

.fast-card{

background:#172033;

padding:18px;

border-radius:15px;

margin-top:10px;

border:1px solid rgba(0,210,255,.25);

}


.fast-player-name{

font-size:30px;

font-weight:bold;

color:gold;

text-align:center;

margin:10px 0;

word-break:break-word;

}


.fast-player-info{

text-align:center;

font-size:13px;

color:#aaa;

}


.continue{

background:#00b894;

}


.remove{

background:#d63031;

}


/* ================= NOTICE ================= */

.notice{

text-align:center;

padding:12px;

border-radius:12px;

background:#172033;

color:#aaa;

font-size:13px;

margin-top:10px;

}


/* ================= ACTIVE PLAYER ================= */

.active-player{

background:#1f2937;

padding:15px;

border-radius:15px;

margin-top:12px;

}


.active-name{

font-size:19px;

font-weight:bold;

margin-bottom:7px;

word-break:break-word;

}


.active-info{

font-size:12px;

color:#aaa;

margin-bottom:10px;

}


.active-buttons{

display:flex;

gap:8px;

}


.keluarkan-player{

width:100%;

background:#d63031;

}


/* ================= SPAM ================= */

.spam-player{

background:#3a1720;

border:1px solid rgba(255,0,0,.35);

padding:15px;

border-radius:15px;

margin-top:12px;

}


.spam-name{

font-size:20px;

font-weight:bold;

color:#ff4d4d;

word-break:break-word;

}


.spam-info{

font-size:12px;

color:#ffaaaa;

margin-top:5px;

line-height:1.5;

}


@media(max-width:500px){

.btn-group{

gap:7px;

}

button{

font-size:12px;

}

}

</style>

</head>


<body>


<div class="header">

CONTROL GAME ALDI

</div>


