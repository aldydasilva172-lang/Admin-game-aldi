.rank-number{
font-family:Orbitron,sans-serif;
font-size:12px;
opacity:.6;
width:25px;
}

.rank-score{
font-family:Orbitron,sans-serif;
color:#00d9ff;
}


/* SETTINGS */

.setting-card{
padding:17px;
border-radius:17px;
background:rgba(255,255,255,.045);
border:1px solid rgba(255,255,255,.07);
margin-bottom:10px;
}

.setting-title{
font-weight:600;
font-size:13px;
}

.setting-desc{
font-size:10px;
opacity:.5;
margin-top:4px;
line-height:1.5;
}

.setting-btn{
width:100%;
margin-top:12px;
padding:12px;
border-radius:12px;
border:0;
color:#fff;
background:rgba(255,255,255,.08);
}

.setting-btn.red{
background:#d71945;
}

.setting-btn.blue{
background:#006cff;
}


/* HISTORY */

.history-item{
padding:15px;
border-radius:17px;
background:rgba(255,255,255,.045);
border:1px solid rgba(255,255,255,.07);
margin-bottom:9px;
}

.history-top{
display:flex;
justify-content:space-between;
align-items:center;
gap:10px;
}

.history-user{
font-weight:600;
font-size:13px;
}

.history-time{
font-size:9px;
opacity:.45;
text-align:right;
}

.history-action{
font-size:11px;
margin-top:6px;
line-height:1.5;
opacity:.8;
}

.history-role{
display:inline-block;
margin-top:7px;
padding:4px 8px;
border-radius:8px;
font-size:8px;
background:rgba(0,217,255,.1);
color:#00d9ff;
}

.history-clear{
width:100%;
margin-bottom:12px;
padding:12px;
border:0;
border-radius:12px;
background:#d71945;
color:#fff;
font-weight:700;
font-size:11px;
}


/* MODAL */

.modal{
position:fixed;
inset:0;
z-index:500;
display:none;
align-items:center;
justify-content:center;
padding:20px;
background:rgba(0,0,0,.65);
}

.modal.show{
display:flex;
}

.modal-box{
width:100%;
max-width:420px;
padding:22px;
border-radius:22px;
background:#101328;
border:1px solid rgba(255,255,255,.1);
box-shadow:0 30px 80px rgba(0,0,0,.6);
}

.modal-title{
font-family:Orbitron,sans-serif;
font-size:15px;
margin-bottom:15px;
}

.modal-text{
font-size:12px;
line-height:1.6;
opacity:.7;
margin-bottom:15px;
}

.modal-actions{
display:flex;
gap:8px;
}

.modal-actions button{
flex:1;
padding:12px;
border-radius:12px;
border:0;
color:#fff;
background:rgba(255,255,255,.08);
}

.modal-actions .confirm{
background:#e91e43;
}


@media(max-width:600px){

.header-inner{
padding:13px 12px;
}

.logo{
font-size:14px;
}

.user-info{
display:none;
}

.stats{
grid-template-columns:repeat(3,1fr);
}

.stat{
padding:12px 5px;
}

.stat-number{
font-size:18px;
}

.stat-label{
font-size:8px;
}

.container{
padding-left:10px;
padding-right:10px;
}

}

</style>

</head>

